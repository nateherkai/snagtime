{
  "name": "snagtime",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nateherkai/snagtime.git"
  },
  "bugs": "https://github.com/nateherkai/snagtime/issues",
  "homepage": "https://github.com/nateherkai/snagtime#readme",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "setup:check": "node scripts/demo-check.mjs --free",
    "dev": "dotenv -e .env.local -- npm run dev --workspace @snagtime/web",
    "dev:persistent": "node scripts/dev-persistent.mjs",
    "dev:persistent:stop": "node scripts/dev-persistent.mjs --stop",
    "build": "npm run build --workspace @snagtime/web",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:start": "node dist/worker.mjs",
    "prod:check": "node scripts/production-config.mjs runtime",
    "ci:secret-scan": "node scripts/ci-secret-scan.mjs",
    "ci:audit-policy": "node scripts/ci-audit-policy.mjs",
    "ci:generated-drift": "node scripts/ci-generated-drift.mjs",
    "ci:postgres-guards": "node scripts/postgres-guard-check.mjs",
    "ci:postgres-runtime": "tsx --tsconfig apps/web/tsconfig.json scripts/postgres-runtime-check.mjs",
    "ci:postgres-rate-policies": "node scripts/postgres-rate-policy-check.mjs",
    "ci:postgres-health": "tsx --tsconfig apps/web/tsconfig.json scripts/postgres-health-check.mts",
    "ci:postgres-authority": "node scripts/postgres-authority-check.mjs",
    "ci:postgres-provision-negative": "node scripts/postgres-provision-negative.mjs",
    "ci:postgres-import-negative": "node scripts/postgres-import-negative.mjs",
    "ci:backup-contract": "node scripts/ci-backup-contract.mjs",
    "ci:postgres-rls": "node scripts/postgres-rls-check.mjs",
    "ci:postgres-app-context": "tsx --tsconfig apps/web/tsconfig.json scripts/postgres-app-context-check.mts",
    "ci:postgres-service-dml": "tsx --tsconfig apps/web/tsconfig.json scripts/postgres-service-dml-check.mts",
    "db:provision:postgres-logins": "node scripts/provision-postgres-logins.mjs",
    "db:import:sqlite-postgres": "node scripts/sqlite-to-postgres.mjs",
    "ci:postgres-backup-fixture": "node scripts/postgres-backup-fixture.mjs",
    "ci:postgres-reconcile": "node scripts/postgres-reconcile.mjs",
    "source:inventory": "node scripts/source-inventory.mjs",
    "release:stage": "node scripts/stage-public-release.mjs",
    "start": "npm run start --workspace @snagtime/web",
    "lint": "eslint apps/web",
    "typecheck": "tsc --project apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:resilience": "vitest run apps/web/src/server/quality/resilience.test.ts apps/web/src/server/services/outbox.test.ts apps/web/src/server/services/notifications.test.ts apps/web/src/server/infrastructure.test.ts apps/web/src/server/rate-limit.test.ts",
    "test:e2e": "node scripts/playwright-matrix.mjs",
    "test:e2e:journey": "node scripts/playwright-matrix.mjs --grep @journey",
    "test:e2e:axe": "node scripts/playwright-matrix.mjs --grep @axe",
    "test:load:sqlite": "tsx --tsconfig apps/web/tsconfig.json scripts/load-check.mts --adapter=sqlite-fallback",
    "test:load:postgres": "tsx --tsconfig apps/web/tsconfig.json scripts/load-check.mts --adapter=postgresql-production",
    "ci:load-fixture-contract": "node scripts/postgres-load-fixture-contract.mjs",
    "test:watch": "vitest",
    "demo:check": "node scripts/demo-check.mjs",
    "stripe:sandbox:import": "pwsh -NoProfile -File scripts/import-stripe-sandbox-profile.ps1",
    "dev:stripe-sandbox": "dotenv -o -e .env.local -e .env.stripe-sandbox.local -- npm run dev",
    "demo:free": "npm ci && npm run demo:check -- --free && dotenv -e .env.local -- npm run db:generate && dotenv -e .env.local -- npm run db:migrate && dotenv -e .env.local -- npm run db:seed && dotenv -e .env.local -- npm run dev",
    "db:generate": "cross-env DATABASE_URL=file:./dev.db prisma generate",
    "db:generate:postgres": "node scripts/generate-postgres-schema.mjs && prisma generate --schema prisma/postgresql/schema.prisma",
    "db:baseline:postgres": "node scripts/generate-postgres-schema.mjs && node scripts/generate-postgres-migration.mjs",
    "db:migrate:postgres": "node scripts/production-config.mjs migration && prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:migrate": "cross-env DATABASE_URL=file:./dev.db prisma migrate deploy",
    "db:seed": "cross-env DATABASE_URL=file:./dev.db tsx prisma/seed.ts",
    "db:reset": "cross-env DATABASE_URL=file:./dev.db prisma migrate reset --force"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "axe-core": "4.13.0",
    "@types/luxon": "3.7.1",
    "@types/node": "24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/smtp-server": "^3.5.12",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "prisma": "6.19.3",
    "smtp-server": "3.19.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "nodemailer": "9.0.5",
    "pg": "8.16.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
