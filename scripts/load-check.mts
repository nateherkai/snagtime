  const payload = { startAt: process.env.LOAD_START_AT, inviteeName: "Load Proof", inviteeEmail: `load@${process.env.LOAD_INVITEE_DOMAIN || "example.com"}`, inviteeTimeZone: "UTC", durationId: process.env.LOAD_DURATION_ID };
