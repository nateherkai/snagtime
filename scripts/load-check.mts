async function sqliteFallback() {
  const root = process.cwd(); const runtime = resolve(root, "runtime", "load"); const file = resolve(runtime, "load.db"); mkdirSync(runtime, { recursive: true });
  for (const suffix of ["", "-journal", "-shm", "-wal"]) rmSync(`${file}${suffix}`, { force: true });
  process.env.NODE_ENV = "test"; process.env.DATABASE_PROVIDER = "sqlite"; process.env.DATABASE_URL = `file:${file.replaceAll("\\", "/")}`; process.env.DEMO_MODE = "true"; process.env.DEMO_HOST_EMAIL = "load-organizer@example.invalid"; process.env.DEMO_HOST_PASSWORD = `Load!${randomBytes(18).toString("base64url")}`; process.env.AUTH_SECRET = randomBytes(32).toString("base64url"); process.env.EMAIL_TOKEN_SECRET = randomBytes(32).toString("base64url"); process.env.TOKEN_ENCRYPTION_KEY = randomBytes(32).toString("hex"); process.env.CALENDAR_PROVIDER = "local"; process.env.PAYMENTS_PROVIDER = "stub"; process.env.EMAIL_PROVIDER = "local"; process.env.OUTBOX_WORKER_MODE = "dedicated"; process.env.RATE_LIMIT_PROVIDER = "local";
  for (const [script, args] of [["node_modules/prisma/build/index.js", ["migrate", "deploy", "--schema", "prisma/schema.prisma"]], ["node_modules/tsx/dist/cli.mjs", ["prisma/seed.ts"]]] as const) { const result = spawnSync(process.execPath, [resolve(root, script), ...args], { cwd: root, env: process.env, shell: false, stdio: "ignore" }); if (result.status !== 0) throw new Error("SQLite fallback setup failed."); }
  const [{ db }, { createBooking }, { enforceRateLimit, resetRateLimitsForTest }] = await Promise.all([import("../apps/web/src/server/db.ts"), import("../apps/web/src/server/services/bookings.ts"), import("../apps/web/src/server/rate-limit.ts")]);
  const event = await db.eventType.findUniqueOrThrow({ where: { slug: "strategy-call" }, include: { durations: true } }); const duration = event.durations.find((item) => item.isDefault)!;
  const nextMonday = new Date(); nextMonday.setUTCDate(nextMonday.getUTCDate() + ((8 - nextMonday.getUTCDay()) % 7 || 7)); nextMonday.setUTCHours(15, 0, 0, 0);
  const input = { startAt: nextMonday.toISOString(), inviteeName: "Load Proof", inviteeEmail: "load@example.invalid", inviteeTimeZone: "America/Chicago", durationId: duration.id };
  async function call(key: string, body = input): Promise<Sample> { const started = performance.now(); try { const result = await createBooking("strategy-call", body, key); return { status: 201, elapsedMs: performance.now() - started, body: { data: { booking: { id: result.booking.id } } } }; } catch (error) { return { status: (error as { status?: number }).status || 409, elapsedMs: performance.now() - started, body: { error: { code: (error as { code?: string }).code } } }; } }
  const loadStarted = performance.now();
  const sameSlot = await Promise.all(Array.from({ length: 100 }, () => call(randomUUID()))); const winnerIds = new Set(sameSlot.flatMap((item) => item.body?.data?.booking?.id ? [item.body.data.booking.id] : []));
  const replayStart = new Date(nextMonday.getTime() + 7 * 86_400_000); const replayInput = { ...input, startAt: replayStart.toISOString() }; const replayKey = randomUUID(); const firstReplay = await call(replayKey, replayInput); const replays = [firstReplay, ...await Promise.all(Array.from({ length: 19 }, () => call(replayKey, replayInput)))]; const replayIds = new Set(replays.flatMap((item) => item.body?.data?.booking?.id ? [item.body.data.booking.id] : []));
  const mismatch = await call(replayKey, { ...replayInput, inviteeName: "Different body" });
  if (winnerIds.size !== 1 || replayIds.size !== 1 || replays.some((item) => item.status !== 201) || mismatch.status !== 409) throw new Error("SQLite concurrency/idempotency authority proof failed.");
  const secondUser = await db.user.create({ data: { email: "load-second@example.com", name: "Second Load Host", passwordHash: "not-used", emailVerifiedAt: new Date(), timeZone: "America/Chicago" } }); const secondWorkspace = await db.workspace.create({ data: { name: "Second Load Workspace", timeZone: "America/Chicago" } }); await db.membership.create({ data: { workspaceId: secondWorkspace.id, userId: secondUser.id, role: "OWNER" } }); const secondSchedule = await db.availabilitySchedule.create({ data: { workspaceId: secondWorkspace.id, userId: secondUser.id, timeZone: "America/Chicago" } }); await db.availabilityInterval.createMany({ data: [1,2,3,4,5].map((dayOfWeek) => ({ scheduleId: secondSchedule.id, dayOfWeek, startMinute: 540, endMinute: 1020 })) }); const secondEvent = await db.eventType.create({ data: { workspaceId: secondWorkspace.id, ownerId: secondUser.id, name: "Independent Load", slug: "independent-load", locationType: "CUSTOM", locationValue: "Local", minimumNoticeMinutes: 0 } }); const secondDuration = await db.eventDuration.create({ data: { eventTypeId: secondEvent.id, label: "30 minutes", durationMinutes: 30, isDefault: true } });
  const crossStart = new Date(nextMonday.getTime() + 14 * 86_400_000); const [crossA, crossB] = await Promise.all([call(randomUUID(), { ...input, startAt: crossStart.toISOString() }), createBooking(secondEvent.slug, { ...input, startAt: crossStart.toISOString(), durationId: secondDuration.id }, randomUUID())]); if (!crossA.body?.data?.booking?.id || !crossB.booking.id) throw new Error("SQLite cross-workspace independent progress failed.");
  const bookingRows = await db.booking.count({ where: { id: { in: [...winnerIds, ...replayIds] } } }); if (bookingRows !== 2) throw new Error("Final booking truth did not reconcile.");
  resetRateLimitsForTest(); const rateResults = await Promise.allSettled(Array.from({ length: 13 }, () => enforceRateLimit("load:public:bounded", 12, 60_000))); if (rateResults.filter((item) => item.status === "fulfilled").length !== 12) throw new Error("Local fallback rate behavior mismatch.");
  const metrics = summary([...sameSlot, ...replays], performance.now() - loadStarted); if (metrics.p95Ms > Number(process.env.LOAD_SQLITE_P95_MS || 20_000)) throw new Error("SQLite fallback p95 threshold failed.");
  console.log(JSON.stringify({ contract: "sqlite-ci-fallback-not-production-load-proof", adapter, hardware: { platform: process.platform, architecture: process.arch, cpu: cpus()[0]?.model || "unknown", logicalCpuCount: cpus().length, memoryBytes: totalmem(), node: process.version }, dataset: "100 same-slot + 20 same-idempotency + mismatch + cross-workspace + bounded local limiter", warmup: 0, metrics, reconciledBookings: bookingRows, sameSlotWinners: winnerIds.size, replayIdentities: replayIds.size, crossWorkspaceAccepted: 2, rateAccepted: 12, rateRejected: 1 }));
  await db.$disconnect();
}

await (adapter === "postgresql-production" ? postgresProduction() : sqliteFallback());
