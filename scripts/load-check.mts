  for (let i = 0; i < 10; i += 1) { const response = await fetch(new URL(`/api/public/${process.env.LOAD_EVENT_SLUG}`, base), { headers: { Origin: base.origin, "x-forwarded-for": "198.51.100.10", "x-tempocove-proxy-secret": process.env.LOAD_PROXY_SHARED_SECRET! }, signal: AbortSignal.timeout(3_000) }); if (!response.ok) { const failure = await response.json().catch(() => ({})) as { error?: { code?: string } }; throw new Error(`Production warmup failed with ${response.status}/${failure.error?.code || "UNKNOWN"}.`); } }
  const missingCredential = await call(randomUUID(), { ...payload, durationId: process.env.LOAD_MISSING_DURATION_ID }, "198.51.100.19", process.env.LOAD_MISSING_EVENT_SLUG);
  if (missingCredential.status !== 503 || missingCredential.body?.error?.code !== "GOOGLE_CALENDAR_RETRY") throw new Error(`Missing Google credential did not fail closed: ${missingCredential.status}/${missingCredential.body?.error?.code || "UNKNOWN"}.`);
