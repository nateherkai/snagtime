    throw new Error(`PostgreSQL concurrency authority reconciliation failed: same-slot=${JSON.stringify(statusCounts(sameSlot))}; replay=${JSON.stringify(statusCounts(replays))}; winnerIds=${winnerIds.size}; replayIds=${replayIds.size}; errors=${JSON.stringify(safeErrors)}.`);
  }
  if (mismatched.status !== 409 || mismatched.body?.error?.code !== "CONFLICT") throw new Error("Same idempotency key with a different body was not rejected with the exact conflict contract.");
  const crossStart = new Date(new Date(payload.startAt!).getTime() + 14 * 86_400_000).toISOString(); const [tenantA, tenantB] = await Promise.all([call(randomUUID(), { ...payload, startAt: crossStart }, "198.51.100.23"), call(randomUUID(), { ...payload, startAt: crossStart, durationId: process.env.LOAD_SECOND_DURATION_ID }, "198.51.100.23", process.env.LOAD_SECOND_EVENT_SLUG)]); if (tenantA.status !== 201 || tenantB.status !== 201 || tenantA.body?.data?.booking?.id === tenantB.body?.data?.booking?.id) throw new Error("Cross-workspace independent progress failed.");
