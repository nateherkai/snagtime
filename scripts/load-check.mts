const adapter = process.argv.find((value) => value.startsWith("--adapter="))?.split("=", 2)[1];
if (adapter !== "sqlite-fallback" && adapter !== "postgresql-production") throw new Error("Use --adapter=sqlite-fallback or --adapter=postgresql-production.");

type Sample = { status: number; elapsedMs: number; body?: { data?: { booking?: { id: string } }; error?: { code?: string; fieldErrors?: Record<string, string[]> } } };
const percentile = (values: number[], ratio: number) => [...values].sort((a, b) => a - b)[Math.min(values.length - 1, Math.ceil(values.length * ratio) - 1)] ?? 0;
function summary(samples: Sample[], wallMs: number) {
  const times = samples.map((item) => item.elapsedMs);
  return { requests: samples.length, successes: samples.filter((item) => item.status >= 200 && item.status < 300).length, errors: samples.filter((item) => item.status >= 400).length, p50Ms: percentile(times, .5), p95Ms: percentile(times, .95), p99Ms: percentile(times, .99), maxMs: Math.max(...times), wallMs, throughputPerSecond: samples.length / (wallMs / 1000 || 1) };
}

async function postgresProduction() {
