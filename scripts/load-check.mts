    if (appIdentity.rows[0]?.current_user !== process.env.LOAD_EXPECTED_APP_ROLE || workerIdentity.rows[0]?.current_user !== process.env.LOAD_EXPECTED_WORKER_ROLE || appIdentity.rows[0]?.current_user === workerIdentity.rows[0]?.current_user) throw new Error("Distinct production database role identity proof failed.");
    const ids = [...winnerIds, ...replayIds, tenantA.body!.data!.booking!.id, tenantB.body!.data!.booking!.id];
    const truth = await proof.query<{ booking_count: string; workspace_count: string; occupancy_count: string; duplicate_occupancy: string; google_provider_count: string }>('SELECT count(*)::text AS booking_count,count(DISTINCT "workspaceId")::text AS workspace_count,count(*) FILTER (WHERE "calendarProviderSnapshot"=\'google\')::text AS google_provider_count,(SELECT count(*)::text FROM "BookingOccupancy" WHERE "bookingId"=ANY($1::text[])) AS occupancy_count,(SELECT count(*)::text FROM (SELECT "workspaceId","hostId","minuteStart" FROM "BookingOccupancy" WHERE "bookingId"=ANY($1::text[]) GROUP BY 1,2,3 HAVING count(*)>1) duplicates) AS duplicate_occupancy FROM "Booking" WHERE id=ANY($1::text[])',[ids]);
    if (Number(truth.rows[0]?.booking_count) !== 4 || Number(truth.rows[0]?.workspace_count) < 2 || Number(truth.rows[0]?.google_provider_count) !== 4 || Number(truth.rows[0]?.occupancy_count) < 4 || Number(truth.rows[0]?.duplicate_occupancy) !== 0) throw new Error("PostgreSQL final booking/occupancy/provider authority reconciliation failed.");
    const queueDeadline = Date.now() + 20_000;
    do {
      const queue = await proof.query<{ integration_pending: string; email_pending: string; dead: string; active_leases: string; heartbeat_fresh: boolean; heartbeat_build_id: string | null }>('SELECT (SELECT count(*) FROM "IntegrationOutbox" WHERE "bookingId"=ANY($1::text[]) AND status IN (\'PENDING\',\'RETRY\',\'PROCESSING\'))::text AS integration_pending,(SELECT count(*) FROM "EmailOutbox" WHERE "bookingId"=ANY($1::text[]) AND status IN (\'PENDING\',\'RETRY\',\'PROCESSING\'))::text AS email_pending,((SELECT count(*) FROM "IntegrationOutbox" WHERE "bookingId"=ANY($1::text[]) AND status=\'DEAD\')+(SELECT count(*) FROM "EmailOutbox" WHERE "bookingId"=ANY($1::text[]) AND status=\'DEAD\'))::text AS dead,((SELECT count(*) FROM "IntegrationOutbox" WHERE "bookingId"=ANY($1::text[]) AND "leaseToken" IS NOT NULL)+(SELECT count(*) FROM "EmailOutbox" WHERE "bookingId"=ANY($1::text[]) AND "leaseToken" IS NOT NULL))::text AS active_leases,EXISTS(SELECT 1 FROM "WorkerHeartbeat" WHERE status IN (\'RUNNING\',\'IDLE\') AND "lastSeenAt">clock_timestamp()-interval \'30 seconds\' AND "buildId"=$2) AS heartbeat_fresh,(SELECT "buildId" FROM "WorkerHeartbeat" ORDER BY "lastSeenAt" DESC LIMIT 1) AS heartbeat_build_id',[ids,process.env.LOAD_EXPECTED_BUILD_ID]);
