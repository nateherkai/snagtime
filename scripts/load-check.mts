  const statusCounts = (items: Sample[]) => Object.fromEntries([...new Set(items.map((item) => item.status))].sort().map((status) => [status, items.filter((item) => item.status === status).length]));
  const sameSlotStatuses = statusCounts(sameSlot); const replayStatuses = statusCounts(replays);
